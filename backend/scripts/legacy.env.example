# Copy this file to  scripts/legacy.env  and fill in the OLD connection details.
# (legacy.env is only read by migrate-legacy-data.js - the app itself never uses it.)

# Old MongoDB cluster that currently holds the heatmap hotspots (your old MONGO_URI).
# Include the database name in the URI if it was not the default "test".
OLD_MONGO_URI=

# Old MySQL database holding claims / escrow / moderation_cases
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=foundai_db
